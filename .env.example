# Runtime
PROVIDER=terminal
PORT=3000
BRAIN_MODE=live

# Photon Spectrum (Person A)
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Tiger Cloud (Person B)
DATABASE_URL=

# Gemini (Person B) — leave empty or USE_GEMINI=0 for template/regex only
GEMINI_API_KEY=
USE_GEMINI=
# GEMINI_MODEL=gemini-3.5-flash-lite
BRAIN_LOG=0

# Navigation for uneasy/busier routing and voice guidance.
# fixture = hand-written demo routes around Columbia (default); geoapify = live data.
NAV_PROVIDER=fixture
GEOAPIFY_API_KEY=
NAV_STALE_SECONDS=30
NAV_OFF_ROUTE_METERS=60
NAV_REROUTE_COOLDOWN_SECONDS=20

# ElevenLabs (Person A, L4). The API key also powers voice-note transcription (Scribe).
ELEVENLABS_API_KEY=
# ELEVENLABS_STT_MODEL=scribe_v1
# Where inbound voice notes are saved (git-ignored)
# VOICE_NOTES_DIR=data/voice-notes
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
TOOLS_SECRET=
# Only for `bun run voice:setup` to import the calling number into ElevenLabs
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Public HTTPS URL of this server (tap-to-talk links, Vonage calls, ElevenLabs tools)
PUBLIC_URL=

# Vonage calls (used when ELEVENLABS_AGENT_PHONE_NUMBER_ID is empty). Trial
# accounts can only call their registered number, from caller ID 123456789.
VONAGE_API_KEY=
VONAGE_API_SECRET=
# Filled in by `bun run vonage:setup`
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY_PATH=./vonage-private.key
VONAGE_FROM_NUMBER=
