# Runtime
PROVIDER=terminal
PORT=3000
BRAIN_MODE=live

# Photon Spectrum (Person A)
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Tiger Cloud (Person B)
DATABASE_URL=

# Gemini (Person B) — leave empty or USE_GEMINI=0 for template/regex only
GEMINI_API_KEY=
USE_GEMINI=
# GEMINI_MODEL=gemini-3.5-flash-lite
BRAIN_LOG=0

# ElevenLabs (Person A, L4)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
TOOLS_SECRET=
# Only for `bun run voice:setup` to import the calling number into ElevenLabs
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Public HTTPS URL of this server (tap-to-talk links, ElevenLabs tools)
PUBLIC_URL=
