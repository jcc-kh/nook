    "sim:l2": "bun run src/sim/scenarios/l2.ts",
    "sim:l3": "bun run src/sim/scenarios/l3.ts",
    "sim:l4": "bun run src/sim/scenarios/l4.ts"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.2"
  }
